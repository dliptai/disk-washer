#!/usr/bin/env bash
# diskWasher — wipe partition remnants from a replacement disk and run basic health checks.
#
# Usage: diskWasher /dev/sdX
#
# Wipes the first and last 100 MB (clears MBR + GPT headers/tail),
# then runs a SMART check and a quick dd read/write speed test.

set -euo pipefail

WIPE_MB=100
BLOCK_SIZE="1M"

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "==> $*"; }

check_speed() {
    local label="$1" line="$2"
    echo "$line" | awk -v label="$label" '{
        for (i=1; i<=NF; i++) {
            if ($i ~ /^[0-9.]+$/ && $(i+1) ~ /^(MB|GB)\/s$/) {
                num = $i
                unit = $(i+1)
                if (unit == "GB/s") num *= 1000
                if (num < 100) print "  WARNING: " label " below 100 MB/s"
                else if (num < 200) print "  NOTE: " label " below 200 MB/s"
                break
            }
        }
    }'
}

[[ $# -eq 1 ]] || die "usage: $0 <device>"
DISK="$1"

[[ -b "$DISK" ]] || die "$DISK is not a block device"

info "target disk: $DISK"

# --- Wipe first and last 100 MB ---
SIZE_BYTES=$(blockdev --getsize64 "$DISK")
[[ -n "$SIZE_BYTES" ]] || die "could not determine size of $DISK"

info "wiping first ${WIPE_MB} MB..."
dd if=/dev/zero of="$DISK" bs="$BLOCK_SIZE" count="$WIPE_MB" oflag=direct conv=notrunc status=progress

info "wiping last ${WIPE_MB} MB..."
OFFSET=$(( (SIZE_BYTES / 1048576) - WIPE_MB ))
dd if=/dev/zero of="$DISK" bs="$BLOCK_SIZE" count="$WIPE_MB" seek="$OFFSET" oflag=direct conv=notrunc status=progress

# --- SMART check ---
if command -v smartctl >/dev/null 2>&1; then
    info "SMART status:"
    smartctl -H "$DISK" || true
    smartctl -i "$DISK" || true
else
    info "smartctl not found, skipping SMART check"
fi

# --- dd write speed ---
info "write speed (1 GB sequential):"
WRITE_LINE=$(dd if=/dev/zero of="$DISK" bs=10M count=100 oflag=direct conv=notrunc status=progress 2>&1 | tee /dev/tty | tail -1)
check_speed "write speed" "$WRITE_LINE"

# --- dd read speed ---
info "read speed (1 GB sequential):"
READ_LINE=$(dd if="$DISK" of=/dev/null bs=10M count=100 iflag=direct status=progress 2>&1 | tee /dev/tty | tail -1)
check_speed "read speed" "$READ_LINE"

info "done. $DISK is ready for use."
