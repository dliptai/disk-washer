#!/bin/bash
# License: MIT (see LICENSE)
#
# diskWasher - wipe partition remnants from a replacement disk and run basic health checks.
#
# Usage: diskWasher /dev/sdX
#
# Wipes the first and last 100 MB (clears MBR + GPT headers/tail),
# then runs a SMART check and a quick dd read/write speed test.

set -euo pipefail

WIPE_MB=100
BLOCK_SIZE="1M"

die()  { echo "error: $*" >&2; exit 1; }
info() { echo ""; echo "==> $*"; }

# Parses dd output for speed. Handles both GNU format ("117 MB/s") and
# BSD/macOS format ("1010188825 bytes/sec"). Normalizes to MB/s for comparison.
check_speed() {
    local label="$1" line="$2"
    echo "$line" | awk -v label="$label" '{
        if (match($0, /[0-9.]+ (MB|GB)\/s/)) {
            speed_str = substr($0, RSTART, RLENGTH)
            sub(/\/s$/, "", speed_str)
            split(speed_str, parts, " ")
            num = parts[1]
            unit = parts[2]
            if (unit == "GB") num *= 1000
        } else if (match($0, /[0-9.]+ bytes\/sec/)) {
            speed_str = substr($0, RSTART, RLENGTH)
            sub(/\/sec$/, "", speed_str)
            sub(/ bytes$/, "", speed_str)
            num = speed_str / 1048576
            unit = "MB"
        } else {
            next
        }
        if (num < 100) print "  WARNING: " label " below 100 MB/s"
        else if (num < 200) print "  NOTE: " label " below 200 MB/s"
    }'
}

[[ $# -eq 1 ]] || die "usage: $0 <device>"
DISK="$1"

[[ -b "$DISK" ]] || die "$DISK is not a block device"

info "target disk: $DISK"

# --- Release kernel software RAID (md) ---
# Stop any md array using the disk before doing anything else.

DISK_NAME=$(basename "$(readlink -f "$DISK")")   # resolves by-id symlinks etc. to e.g. "sdc"

# Print md devices (e.g. md126) that have the disk, or a partition of it, as a member.
md_users() {
    local md dev real
    for md in /sys/block/md*; do
        [[ -d $md/md ]] || continue               # skip if glob didn't match / not an md array
        for dev in "$md"/md/dev-*; do             # one dev-<name> entry per member device
            [[ -e $dev/block ]] || continue
            real=$(readlink -f "$dev/block")      # e.g. .../block/sdc  or  .../block/sdc/sdc1
            # Match if this member is the target disk itself or one of its partitions.
            #   whole disk: .../block/sdc       -> basename is "sdc"
            #   partition:  .../block/sdc/sdc1  -> basename is "sdc1", but the parent dir is "sdc"
            if [[ $(basename "$real") == "$DISK_NAME" || $(basename "$(dirname "$real")") == "$DISK_NAME" ]]; then
                basename "$md"
                break                             # one hit per array is enough
            fi
        done
    done
}

MDS=$(md_users)
if [[ -n $MDS ]]; then
    command -v mdadm >/dev/null 2>&1 || die "$DISK is in an md array but mdadm is not installed"

    # A container (e.g. DDF) can't be stopped while a subarray is active, so
    # stop subarrays first. Subarrays have metadata_version "external:/mdXXX/N".
    # (Plain strings, not arrays: bash 4.2 + set -u chokes on empty arrays.)
    MEMBERS="" OTHERS=""
    for md in $MDS; do
        if [[ $(cat "/sys/block/$md/md/metadata_version" 2>/dev/null) == external:/* ]]; then
            MEMBERS="$MEMBERS $md"
        else
            OTHERS="$OTHERS $md"
        fi
    done

    # Log the member list too: stopping a container also releases its other disks
    for md in $MEMBERS $OTHERS; do
        info "stopping /dev/$md (members: $(ls -d /sys/block/$md/md/dev-* 2>/dev/null | sed 's|.*/dev-||' | tr '\n' ' '))"
        mdadm --stop "/dev/$md"
    done

    # Sanity check: refuse to wipe if md still holds the disk
    [[ -z $(md_users) ]] || die "$DISK is still claimed by md after stopping arrays"

    # With md gone, let multipath re-claim the paths it was blocked from
    if systemctl is-active --quiet multipathd; then
        info "restarting multipathd..."
        systemctl restart multipathd
        udevadm settle                            # wait for udev to finish creating mpath maps
    fi
fi

# --- Wipe first and last 100 MB ---
SIZE_BYTES=$(blockdev --getsize64 "$DISK")
[[ -n "$SIZE_BYTES" ]] || die "could not determine size of $DISK"

# Disk must be at least 200 MB to wipe first and last 100 MB without overlap.
[[ $SIZE_BYTES -ge 209715200 ]] || die "$DISK is too small (< 200 MB)"

info "wiping first ${WIPE_MB} MB..."
dd if=/dev/zero of="$DISK" bs="$BLOCK_SIZE" count="$WIPE_MB" oflag=direct conv=notrunc status=progress

info "wiping last ${WIPE_MB} MB..."
OFFSET=$(( (SIZE_BYTES / 1048576) - WIPE_MB ))
dd if=/dev/zero of="$DISK" bs="$BLOCK_SIZE" count="$WIPE_MB" seek="$OFFSET" oflag=direct conv=notrunc status=progress

# --- SMART check ---
if command -v smartctl >/dev/null 2>&1; then
    info "SMART data:"
    smartctl -a "$DISK" || true
else
    info "smartctl not found, skipping SMART check"
fi

# --- Partition probe ---
info "probing partition table:"
partprobe "$DISK"

# --- dd write speed ---
info "write speed (1 GB sequential):"
WRITE_LINE=$(dd if=/dev/zero of="$DISK" bs=10M count=100 oflag=direct conv=notrunc status=progress 2>&1 | tee /dev/tty | tail -1)
check_speed "write speed" "$WRITE_LINE"

# --- dd read speed ---
info "read speed (1 GB sequential):"
READ_LINE=$(dd if="$DISK" of=/dev/null bs=10M count=100 iflag=direct status=progress 2>&1 | tee /dev/tty | tail -1)
check_speed "read speed" "$READ_LINE"

info "done. $DISK is ready for use."
